# PostgreSQL (local docker-compose)
POSTGRES_USER=buildflow_user
POSTGRES_PASSWORD=buildflow_pass
POSTGRES_DB=buildflow_db

# Backend
# Local: postgresql://buildflow_user:buildflow_pass@localhost:5432/buildflow_db
# Neon (production): postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://buildflow_user:buildflow_pass@postgres:5432/buildflow_db
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
